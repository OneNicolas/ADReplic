<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>ADReplic.App</RootNamespace>
    <AssemblyName>ADReplic</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\ADReplic.ico</ApplicationIcon>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ADReplic.Core\ADReplic.Core.csproj" />
  </ItemGroup>

  <!-- Fusion de ADReplic.Core.dll dans ADReplic.exe en Release : voir ILRepack.targets
       (cible MergeIntoSingleExe, sortie dans bin\Release\net48\single\). -->
  <ItemGroup>
    <PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.44.2" PrivateAssets="all" />
  </ItemGroup>

</Project>
