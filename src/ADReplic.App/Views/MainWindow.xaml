<Window x:Class="ADReplic.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ADReplic.App.ViewModels"
        mc:Ignorable="d"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="ADReplic — État de réplication AD"
        Height="740" Width="1280"
        MinHeight="540" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Surface}">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenJsonAuditCommand}" />
    </Window.InputBindings>

    <!-- Styles du panneau de détail (v0.7.0), partagés par Échecs actifs et Diagnostics. -->
    <Window.Resources>
        <Style x:Key="DetailHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
        <Style x:Key="DetailBody" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource SubtleText}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="DetailLinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <!-- Liste à puces simple : chaque item est une chaîne. -->
        <DataTemplate x:Key="BulletItemTemplate">
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="•" Style="{StaticResource DetailBody}" />
                <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource DetailBody}" />
            </Grid>
        </DataTemplate>

        <!-- Liste numérotée : chaque item est une chaîne, le numéro vient de l'index via
             AlternationIndex (ItemsControl.AlternationCount suffisamment grand). -->
        <DataTemplate x:Key="NumberedItemTemplate">
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource DetailBody}"
                           Text="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter},
                                          Path=(ItemsControl.AlternationIndex),
                                          Converter={x:Static vm:AlternationIndexToNumberConverter.Instance},
                                          Mode=OneWay}" />
                <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource DetailBody}" />
            </Grid>
        </DataTemplate>

        <!-- Commande à copier : texte monospace + bouton Copier. -->
        <DataTemplate x:Key="CommandItemTemplate">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{DynamicResource SurfaceAlt}"
                        BorderBrush="{DynamicResource Border}" BorderThickness="1"
                        CornerRadius="3" Padding="6,3">
                    <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12"
                               Foreground="{DynamicResource Foreground}" TextWrapping="Wrap" />
                </Border>
                <Button Grid.Column="1" Content="Copier" Margin="6,0,0,0" Padding="8,2"
                        VerticalAlignment="Center"
                        Command="{Binding DataContext.CopyTextCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <!-- Grid racine : permet de superposer le toast en overlay au-dessus du DockPanel. -->
    <Grid>

        <DockPanel LastChildFill="True">

            <!-- ====================================================================
                 Barre de menu (Fichier, Outils, Aide)
                 ==================================================================== -->
            <Menu DockPanel.Dock="Top" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                <MenuItem Header="_Fichier" Foreground="{DynamicResource Foreground}">
                    <MenuItem Header="_Actualiser"        Command="{Binding RefreshCommand}"
                              InputGestureText="F5" />
                    <MenuItem Header="_Ouvrir un audit JSON…" Command="{Binding OpenJsonAuditCommand}"
                              InputGestureText="Ctrl+O" />
                    <Separator />
                    <MenuItem Header="Exporter en _CSV"   Command="{Binding ExportCommand}" CommandParameter="CSV" />
                    <MenuItem Header="Exporter en _JSON"  Command="{Binding ExportCommand}" CommandParameter="JSON" />
                    <MenuItem Header="Exporter en _HTML"  Command="{Binding ExportCommand}" CommandParameter="HTML" />
                    <Separator />
                    <MenuItem Header="C_omparer deux audits…" Command="{Binding OpenCompareDialogCommand}" />
                    <Separator />
                    <MenuItem Header="_Quitter" Click="OnQuitClick" InputGestureText="Alt+F4" />
                </MenuItem>
                <MenuItem Header="_Outils" Foreground="{DynamicResource Foreground}">
                    <MenuItem Header="_Identifiants alternatifs…" Command="{Binding EditCredentialsCommand}" />
                    <MenuItem Header="_Réinitialiser la cible"    Command="{Binding ResetTargetCommand}" />
                    <Separator />
                    <MenuItem Header="_Surveillance">
                        <MenuItem Header="_Activer la surveillance"
                                  IsCheckable="True"
                                  IsChecked="{Binding IsAutoRefreshEnabled, Mode=TwoWay}" />
                        <MenuItem Header="_Intervalle">
                            <MenuItem Header="_5 minutes"  IsCheckable="True"
                                      IsChecked="{Binding AutoRefreshIntervalMinutes, Mode=OneWay, Converter={x:Static vm:EqualsConverter.Instance}, ConverterParameter=5}"
                                      Command="{Binding SetAutoRefreshIntervalCommand}" CommandParameter="5" />
                            <MenuItem Header="_15 minutes" IsCheckable="True"
                                      IsChecked="{Binding AutoRefreshIntervalMinutes, Mode=OneWay, Converter={x:Static vm:EqualsConverter.Instance}, ConverterParameter=15}"
                                      Command="{Binding SetAutoRefreshIntervalCommand}" CommandParameter="15" />
                            <MenuItem Header="_30 minutes" IsCheckable="True"
                                      IsChecked="{Binding AutoRefreshIntervalMinutes, Mode=OneWay, Converter={x:Static vm:EqualsConverter.Instance}, ConverterParameter=30}"
                                      Command="{Binding SetAutoRefreshIntervalCommand}" CommandParameter="30" />
                            <MenuItem Header="_60 minutes" IsCheckable="True"
                                      IsChecked="{Binding AutoRefreshIntervalMinutes, Mode=OneWay, Converter={x:Static vm:EqualsConverter.Instance}, ConverterParameter=60}"
                                      Command="{Binding SetAutoRefreshIntervalCommand}" CommandParameter="60" />
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Ouvrir le _dossier des snapshots…"
                                  Command="{Binding OpenSnapshotsFolderCommand}" />
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="_Thème">
                        <MenuItem Header="_Clair"  Click="OnThemeLightClick" />
                        <MenuItem Header="_Sombre" Click="OnThemeDarkClick" />
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="_Aide" Foreground="{DynamicResource Foreground}">
                    <MenuItem Header="_Guide de démarrage"     Click="OnHelpClick" />
                    <MenuItem Header="_Documentation en ligne" Click="OnDocsClick" />
                    <Separator />
                    <MenuItem Header="À _propos d'ADReplic…"   Click="OnAboutClick" />
                </MenuItem>
            </Menu>

            <!-- ====================================================================
                 Header : titre + badges + actions + cible
                 ==================================================================== -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceElevated}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"
                    Padding="24,16">
                <StackPanel>

                    <!-- Ligne 1 : titre à gauche, actions + badge alerte à droite.
                         Le badge de score a été déplacé dans la status bar (v0.5.0) pour
                         libérer le header devenu trop chargé quand le Summary du score
                         devenait verbeux. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Logo + titre, aligné à gauche -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="{StaticResource AppIcon}" Width="36" Height="36" Margin="0,0,12,0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="ADReplic" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Foreground}" />
                                <TextBlock Text="{Binding ForestName, StringFormat='Forêt découverte : {0}', TargetNullValue='Forêt : (non découverte)'}"
                                           Foreground="{DynamicResource SubtleText}" FontSize="12" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Badge alerte + actions à droite -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    VerticalAlignment="Center" HorizontalAlignment="Right">

                            <!-- Badge alerte clignotant, visible si HasPendingAlert -->
                            <Border x:Name="HeaderAlertBadge"
                                    Padding="10,6" CornerRadius="4"
                                    VerticalAlignment="Center"
                                    Margin="0,0,12,0"
                                    Cursor="Hand"
                                    Background="{DynamicResource AlertBadgeBackground}"
                                    Visibility="{Binding HasPendingAlert, Converter={x:Static vm:BoolToVisibleConverter.Instance}}"
                                    ToolTip="{Binding PendingAlertSummary}">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding AcknowledgeAlertCommand}" />
                                </Border.InputBindings>
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="1" To="0.5" Duration="0:0:0.8" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="(!)" FontWeight="Bold" FontSize="14"
                                               Foreground="{DynamicResource AlertBadgeForeground}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="Alerte" FontWeight="SemiBold" FontSize="12"
                                               Foreground="{DynamicResource AlertBadgeForeground}"
                                               VerticalAlignment="Center" Margin="6,0,0,0" />
                                </StackPanel>
                            </Border>

                            <Button x:Name="ExportButton" Content="Exporter ▾" Margin="0,0,10,0"
                                    Click="OnExportButtonClick">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Tableurs (CSV)" Command="{Binding ExportCommand}" CommandParameter="CSV" />
                                        <MenuItem Header="Données (JSON)" Command="{Binding ExportCommand}" CommandParameter="JSON" />
                                        <MenuItem Header="Rapport (HTML)" Command="{Binding ExportCommand}" CommandParameter="HTML" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <Button Content="Actualiser" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding RefreshCommand}" />
                        </StackPanel>
                    </Grid>

                    <!-- Ligne 2 -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="280" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Forêt cible" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SubtleText}" FontSize="12"
                                   FontWeight="SemiBold" Margin="0,0,10,0" />

                        <TextBox Grid.Column="1"
                                 Text="{Binding TargetForestName, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Laisser vide pour interroger la forêt courante de cette machine." />

                        <TextBlock Grid.Column="2" Text="DC cible" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SubtleText}" FontSize="12"
                                   FontWeight="SemiBold" Margin="18,0,10,0" />

                        <TextBox Grid.Column="3"
                                 Text="{Binding TargetDcHostName, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Mode DC seul : n'auditer qu'un contrôleur précis (FQDN). Laisser vide pour un audit complet." />

                        <TextBlock Grid.Column="4" Text="{Binding TargetSummary}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SubtleText}" FontSize="12"
                                   Margin="14,0,14,0" TextTrimming="CharacterEllipsis" />

                        <Button Grid.Column="5" Content="Identifiants…" Margin="0,0,8,0"
                                Command="{Binding EditCredentialsCommand}"
                                ToolTip="Définir des identifiants alternatifs pour l'audit." />

                        <Button Grid.Column="6" Content="Réinitialiser"
                                Command="{Binding ResetTargetCommand}"
                                ToolTip="Revenir à la forêt courante et aux identifiants Windows." />
                    </Grid>

                </StackPanel>
            </Border>

            <!-- ====================================================================
                 Footer / status bar (v0.5.0) :
                 - Indicateur d'activité (vert/bleu)
                 - Badge score compact, cliquable pour ouvrir l'historique
                 - Status message textuel
                 - Badge alerte compact à droite (en plus du header)
                 ==================================================================== -->
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceElevated}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"
                    Padding="24,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />  <!-- Indicateur d'activité -->
                        <ColumnDefinition Width="Auto" />  <!-- Badge score -->
                        <ColumnDefinition Width="*" />     <!-- Status message -->
                        <ColumnDefinition Width="Auto" />  <!-- Badge alerte -->
                    </Grid.ColumnDefinitions>

                    <!-- Indicateur d'activité (vert / bleu) -->
                    <Grid Grid.Column="0" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Margin="0,0,10,0"
                                 Fill="{DynamicResource Success}"
                                 Visibility="{Binding IsBusy, Converter={x:Static vm:BoolToCollapsedConverter.Instance}}" />
                        <Ellipse Width="8" Height="8" Margin="0,0,10,0"
                                 Fill="{DynamicResource Accent}"
                                 Visibility="{Binding IsBusy, Converter={x:Static vm:BoolToVisibleConverter.Instance}}" />
                    </Grid>

                    <!-- Badge score compact (cliquable -> popover historique).
                         Placé ici depuis v0.5.0. Le Summary complet est dans le tooltip
                         pour ne pas surcharger la status bar. -->
                    <Border Grid.Column="1" x:Name="ScoreBadge"
                            Padding="10,3" CornerRadius="4"
                            Margin="0,0,14,0"
                            VerticalAlignment="Center"
                            Cursor="Hand"
                            MouseLeftButtonUp="OnScoreBadgeClick"
                            Background="{Binding HealthScore.Level, Converter={x:Static vm:HealthLevelToBrushConverter.Instance}}"
                            Visibility="{Binding HasHealthScore, Converter={x:Static vm:BoolToVisibleConverter.Instance}}"
                            ToolTip="{Binding HealthScore.Summary}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding HealthScore.Value, StringFormat='{}{0}/100'}"
                                       Foreground="White" FontWeight="Bold" FontSize="12"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding HealthScore.Label}"
                                       Foreground="White" Opacity="0.92" FontSize="11"
                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Popup historique des scores (placé ici pour rester proche du badge).
                         Placement=Top : s'ouvre AU-DESSUS du badge, sinon il sortirait
                         sous la fenêtre puisque la status bar est en bas. -->
                    <Popup x:Name="HistoryPopup"
                           PlacementTarget="{Binding ElementName=ScoreBadge}"
                           Placement="Top"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="Fade">
                        <Border Background="{DynamicResource SurfaceElevated}"
                                BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                Padding="14" CornerRadius="6"
                                MinWidth="320" Margin="8,8,8,8">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" Opacity="0.25"
                                                  BlurRadius="12" ShadowDepth="2" />
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="Historique des scores"
                                           FontWeight="SemiBold" FontSize="13"
                                           Foreground="{DynamicResource Foreground}"
                                           Margin="0,0,0,8" />
                                <Border Background="{DynamicResource SurfaceAlt}"
                                        BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                        CornerRadius="3" Padding="6" Height="120">
                                    <ItemsControl ItemsSource="{Binding ScoreHistoryEntries}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="6"
                                                        Height="{Binding OverallScore}"
                                                        Margin="1,0,0,0"
                                                        VerticalAlignment="Bottom"
                                                        Background="{Binding Level, Converter={x:Static vm:HealthLevelToBrushConverter.Instance}}">
                                                            <Border.ToolTip>
                                                                <TextBlock>
                                                                    <Run Text="{Binding CapturedAt, StringFormat='{}{0:dd/MM HH:mm}', Mode=OneWay}" />
                                                                    <LineBreak />
                                                                    <Run Text="Score : " />
                                                                    <Run Text="{Binding OverallScore, Mode=OneWay}" />
                                                                    <Run Text="/100" />
                                                                </TextBlock>
                                                            </Border.ToolTip>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                                <TextBlock Margin="0,8,0,0"
                                           Foreground="{DynamicResource SubtleText}"
                                           FontSize="11">
                                    <Run Text="50 dernières captures (axe Y : 0 à 100)." />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <TextBlock Grid.Column="2" Text="{Binding StatusMessage}"
                               Foreground="{DynamicResource SubtleText}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />

                    <!-- Badge alerte compact (en plus du header). Même visibilité. -->
                    <Border Grid.Column="3"
                            Padding="8,3" CornerRadius="3"
                            VerticalAlignment="Center"
                            Background="{DynamicResource AlertBadgeBackground}"
                            Cursor="Hand"
                            Visibility="{Binding HasPendingAlert, Converter={x:Static vm:BoolToVisibleConverter.Instance}}"
                            ToolTip="{Binding PendingAlertSummary}">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding AcknowledgeAlertCommand}" />
                        </Border.InputBindings>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="1" To="0.5" Duration="0:0:0.8" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                        <TextBlock Text="(!) Alerte"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AlertBadgeForeground}" />
                    </Border>
                </Grid>
            </Border>

            <!-- ====================================================================
                 Bandeau de synthèse (v0.7.0) : une phrase en français clair, colorée
                 selon le niveau du score. Visible seulement après un audit.
                 ==================================================================== -->
            <Border DockPanel.Dock="Top" Margin="20,12,20,0" Padding="14,10" CornerRadius="6"
                    BorderThickness="1,1,1,1"
                    BorderBrush="{Binding HealthScore.Level, Converter={x:Static vm:HealthLevelToBrushConverter.Instance}}"
                    Background="{DynamicResource SurfaceElevated}"
                    Visibility="{Binding HasAuditSummary, Converter={x:Static vm:BoolToVisibleConverter.Instance}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="6" CornerRadius="3" Margin="0,0,12,0"
                            Background="{Binding HealthScore.Level, Converter={x:Static vm:HealthLevelToBrushConverter.Instance}}" />
                    <TextBlock Grid.Column="1" Text="{Binding AuditSummary}"
                               FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"
                               Foreground="{DynamicResource Foreground}" />
                </Grid>
            </Border>

            <!-- ====================================================================
                 Onglets de contenu
                 ==================================================================== -->
            <Border Padding="20,12,20,16">
                <TabControl>

                    <TabItem Header="Contrôleurs de domaine">
                        <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="0">
                            <DataGrid ItemsSource="{Binding DomainControllers}"
                                      CanUserResizeColumns="True" CanUserSortColumns="True"
                                      CanUserReorderColumns="True">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Tag"
                                                Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                        <Setter Property="ContextMenu">
                                            <Setter.Value>
                                                <ContextMenu>
                                                    <MenuItem Header="Auditer ce DC seul"
                                                              Command="{Binding PlacementTarget.Tag.AuditSingleDcCommand,
                                                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding}" />
                                                </ContextMenu>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="" Width="36" CanUserResize="False" SortMemberPath="IsReachable">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Ellipse Width="10" Height="10"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                                         Fill="{Binding IsReachable, Converter={x:Static vm:ReachabilityToBrushConverter.Instance}}"
                                                         ToolTip="{Binding IsReachable, Converter={x:Static vm:ReachabilityToTextConverter.Instance}}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn  Header="Contrôleur"  Binding="{Binding HostName}"  Width="260" MinWidth="120" SortMemberPath="HostName" />
                                    <DataGridTextColumn  Header="Domaine"     Binding="{Binding Domain}"    Width="180" MinWidth="100" SortMemberPath="Domain" />
                                    <DataGridTextColumn  Header="Site"        Binding="{Binding SiteName}"  Width="160" MinWidth="100" SortMemberPath="SiteName" />
                                    <DataGridTextColumn  Header="IP"          Binding="{Binding IPAddress}" Width="120" MinWidth="100" SortMemberPath="IPAddress" />
                                    <DataGridTextColumn  Header="OS"          Binding="{Binding OSVersion}" Width="200" MinWidth="120" SortMemberPath="OSVersion" />
                                    <DataGridCheckBoxColumn Header="GC"       Binding="{Binding IsGlobalCatalog}" Width="60" MinWidth="50" SortMemberPath="IsGlobalCatalog" />
                                    <DataGridTextColumn  Header="Rôles FSMO"  Binding="{Binding Roles, Converter={x:Static vm:StringJoinConverter.Instance}}" Width="*" MinWidth="200" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </TabItem>

                    <TabItem Header="Échecs actifs">
                        <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" MinHeight="120" />
                                    <RowDefinition Height="Auto" />
                                    <!-- Ligne du panneau de détail : proportionnelle (plafonnée) quand il est ouvert,
                                         Auto sinon. Deux lignes * ne débordent jamais de la carte, contrairement à une
                                         ligne Auto + MinHeight qui poussait le bas du panneau hors écran. -->
                                    <RowDefinition x:Name="FailureDetailRow">
                                        <RowDefinition.Style>
                                            <Style TargetType="RowDefinition">
                                                <Setter Property="Height" Value="Auto" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasSelectedFailure}" Value="True">
                                                        <Setter Property="Height" Value="1.5*" />
                                                        <Setter Property="MaxHeight" Value="320" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </RowDefinition.Style>
                                    </RowDefinition>
                                </Grid.RowDefinitions>

                                <DataGrid Grid.Row="0" x:Name="FailuresGrid" ItemsSource="{Binding ReplicationFailures}"
                                          SelectedItem="{Binding SelectedFailure, Mode=TwoWay}"
                                          SelectionMode="Single" IsReadOnly="True"
                                          CanUserResizeColumns="True" CanUserSortColumns="True"
                                          CanUserReorderColumns="True">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="" Width="36" CanUserResize="False" CanUserSort="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Ellipse Width="10" Height="10"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                                         Fill="{Binding Severity, Converter={x:Static vm:FailureSeverityToBrushConverter.Instance}}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Destination"   Binding="{Binding DestinationDc}" Width="220" MinWidth="120" SortMemberPath="DestinationDc" />
                                    <DataGridTextColumn Header="Source"        Binding="{Binding SourceDc}"      Width="220" MinWidth="120" SortMemberPath="SourceDc" />
                                    <DataGridTextColumn Header="Premier échec" Binding="{Binding FirstFailureTime, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="150" MinWidth="100" SortMemberPath="FirstFailureTime" />
                                    <DataGridTextColumn Header="Durée"         Binding="{Binding FailureDuration, Converter={x:Static vm:DurationToHumanTextConverter.Instance}}" Width="135" MinWidth="90" SortMemberPath="FailureDuration" />
                                    <DataGridTextColumn Header="Tentatives"    Binding="{Binding ConsecutiveFailureCount}" Width="90" MinWidth="60" SortMemberPath="ConsecutiveFailureCount" />
                                    <!-- Titre clair du catalogue ; le message système brut reste disponible en tooltip. -->
                                    <DataGridTemplateColumn Header="Erreur" Width="*" MinWidth="220" SortMemberPath="ErrorTitle">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ErrorTitle, Mode=OneWay}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding LastErrorMessage}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                                </DataGrid>

                                <!-- Bandeau vert seulement après un audit abouti (v0.8.0) : avant le premier
                                     audit ou après une erreur, une grille vide n'est pas une bonne nouvelle. -->
                                <TextBlock Grid.Row="0" Text="✓ Aucun échec de réplication en cours."
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Success}"
                                           FontSize="14" FontWeight="SemiBold"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding HasItems, ElementName=FailuresGrid}" Value="False" />
                                                        <Condition Binding="{Binding HasAuditData}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Row="0" Text="{Binding EmptyStateMessage}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource SubtleText}"
                                           FontSize="14" FontWeight="SemiBold"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding HasItems, ElementName=FailuresGrid}" Value="False" />
                                                        <Condition Binding="{Binding HasAuditData}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Invite discrète quand il y a des échecs mais rien de sélectionné. -->
                                <Border Grid.Row="2" Padding="14,8" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding HasItems, ElementName=FailuresGrid}" Value="True" />
                                                        <Condition Binding="{Binding HasSelectedFailure}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="Sélectionnez un échec pour voir ce qu'il signifie et comment le corriger."
                                               Style="{StaticResource DetailLabel}" />
                                </Border>

                                <!-- Panneau de détail (v0.7.0) : visible uniquement avec une sélection. -->
                                <!-- Thumb et non GridSplitter : ce dernier figerait aussi la ligne * de la grille en pixels,
                                     et la zone ne suivrait plus la fenêtre (bas du panneau coupé). Code-behind : WireDetailPanelResize. -->
                                <Thumb x:Name="FailureDetailSplitter" Grid.Row="1" Height="5" Cursor="SizeNS" Focusable="False"
                                       Visibility="{Binding HasSelectedFailure, Converter={x:Static vm:BoolToVisibleConverter.Instance}}">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{DynamicResource Border}" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                                <!-- Visibility resolue contre le DataContext de la fenetre : sur ce Border le
                                     DataContext est remplace par la selection (null = binding muet = visible).
                                     La hauteur vient de la ligne de grille (style ci-dessus + poignee en code-behind). -->
                                <Border x:Name="FailureDetailPanel" Grid.Row="2" Padding="14,6,14,12"
                                        Visibility="{Binding DataContext.HasSelectedFailure, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static vm:BoolToVisibleConverter.Instance}}"
                                        DataContext="{Binding SelectedFailure}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding ErrorTitle, Mode=OneWay}"
                                                           FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource Foreground}" VerticalAlignment="Center" />
                                                <Button Grid.Column="1" Content="Copier le diagnostic" Margin="12,0,0,0" Padding="10,4"
                                                        Style="{StaticResource PrimaryButton}"
                                                        ToolTip="Copie la fiche complète (texte brut + HTML) pour un mail ou un ticket."
                                                        Command="{Binding DataContext.CopyFailureDiagnosticCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                <Button Grid.Column="2" Content="✕" Margin="6,0,0,0" Padding="8,4" ToolTip="Fermer le panneau"
                                                        Command="{Binding DataContext.CloseFailureDetailCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            </Grid>
                                            <TextBlock Style="{StaticResource DetailLabel}" Margin="0,2,0,0">
                                                <Run Text="Code " /><Run Text="{Binding LastErrorCode, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding LastErrorMessage, Mode=OneWay}" />
                                            </TextBlock>

                                            <TextBlock Text="Ce que cela signifie" Style="{StaticResource DetailHeading}" />
                                            <TextBlock Text="{Binding Explanation.Explanation, Mode=OneWay}" Style="{StaticResource DetailBody}" />

                                            <TextBlock Text="Causes probables" Style="{StaticResource DetailHeading}"
                                                       Visibility="{Binding Explanation.ProbableCauses, Converter={x:Static vm:NullToCollapsedConverter.Instance}}" />
                                            <ItemsControl ItemsSource="{Binding Explanation.ProbableCauses, Mode=OneWay}"
                                                          ItemTemplate="{StaticResource BulletItemTemplate}" />

                                            <TextBlock Text="Que vérifier" Style="{StaticResource DetailHeading}"
                                                       Visibility="{Binding Explanation.Checks, Converter={x:Static vm:NullToCollapsedConverter.Instance}}" />
                                            <ItemsControl ItemsSource="{Binding Explanation.Checks, Mode=OneWay}"
                                                          AlternationCount="100"
                                                          ItemTemplate="{StaticResource NumberedItemTemplate}" />

                                            <TextBlock Text="Commandes à copier" Style="{StaticResource DetailHeading}"
                                                       Visibility="{Binding Explanation.Commands, Converter={x:Static vm:NullToCollapsedConverter.Instance}}" />
                                            <ItemsControl ItemsSource="{Binding Explanation.Commands, Mode=OneWay}"
                                                          ItemTemplate="{StaticResource CommandItemTemplate}" />

                                            <Button Style="{StaticResource DetailLinkButton}" Margin="0,10,0,0"
                                                    Content="Documentation Microsoft ↗"
                                                    Visibility="{Binding Explanation.DocumentationUrl, Converter={x:Static vm:NullToCollapsedConverter.Instance}}"
                                                    Click="OnOpenUrlClick" Tag="{Binding Explanation.DocumentationUrl, Mode=OneWay}" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Border>
                    </TabItem>

                    <TabItem Header="Réplication">
                        <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="0">
                            <Grid>
                                <DataGrid x:Name="ReplicationGrid" ItemsSource="{Binding ReplicationLinks}"
                                          CanUserResizeColumns="True" CanUserSortColumns="True"
                                          CanUserReorderColumns="True">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="" Width="36" CanUserResize="False" CanUserSort="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Ellipse Width="10" Height="10"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                                         Fill="{Binding Status, Converter={x:Static vm:ReplicationStatusToBrushConverter.Instance}}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Destination"         Binding="{Binding DestinationDc}"   Width="200" MinWidth="120" SortMemberPath="DestinationDc" />
                                    <DataGridTextColumn Header="Source"              Binding="{Binding SourceDc}"        Width="200" MinWidth="120" SortMemberPath="SourceDc" />
                                    <DataGridTextColumn Header="Contexte de nommage" Binding="{Binding NamingContext}"   Width="260" MinWidth="160" SortMemberPath="NamingContext" />
                                    <DataGridTextColumn Header="Type"                Binding="{Binding PartitionType}"   Width="120" MinWidth="80" SortMemberPath="PartitionType" />
                                    <DataGridTextColumn Header="Dernier succès"      Binding="{Binding LastSuccess, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="140" MinWidth="100" SortMemberPath="LastSuccess" />
                                    <DataGridTextColumn Header="Dernière tentative"  Binding="{Binding LastAttempt, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="140" MinWidth="100" SortMemberPath="LastAttempt" />
                                    <DataGridTextColumn Header="Latence"             Binding="{Binding Latency, Converter={x:Static vm:LatencyToTextConverter.Instance}}" Width="90" MinWidth="60" SortMemberPath="Latency" />
                                    <DataGridTextColumn Header="Échecs"              Binding="{Binding ConsecutiveFailures}" Width="80" MinWidth="60" SortMemberPath="ConsecutiveFailures" />
                                    <DataGridTextColumn Header="Message"             Binding="{Binding LastResultMessage}" Width="*" MinWidth="200" />
                                </DataGrid.Columns>
                                </DataGrid>

                                <TextBlock Text="Aucun lien de réplication collecté — lancez Actualiser. (Une forêt mono-DC n'en possède aucun.)"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource SubtleText}"
                                           FontSize="14" FontWeight="SemiBold"
                                           IsHitTestVisible="False"
                                           Visibility="{Binding HasItems, ElementName=ReplicationGrid,
                                                        Converter={x:Static vm:BoolToCollapsedConverter.Instance}}" />
                            </Grid>
                        </Border>
                    </TabItem>

                    <TabItem Header="Sites">
                        <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="0">
                            <DataGrid ItemsSource="{Binding Sites}"
                                      CanUserResizeColumns="True" CanUserSortColumns="True"
                                      CanUserReorderColumns="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Site"          Binding="{Binding Name}"     Width="180" MinWidth="100" SortMemberPath="Name" />
                                    <DataGridTextColumn Header="Localisation"  Binding="{Binding Location}" Width="180" MinWidth="100" SortMemberPath="Location" />
                                    <DataGridTextColumn Header="Contrôleurs"   Binding="{Binding DomainControllers, Converter={x:Static vm:StringJoinConverter.Instance}}" Width="260" MinWidth="160" />
                                    <DataGridTextColumn Header="Sous-réseaux"  Binding="{Binding Subnets, Converter={x:Static vm:StringJoinConverter.Instance}}" Width="220" MinWidth="140" />
                                    <DataGridTextColumn Header="Têtes de pont" Binding="{Binding BridgeheadServers, Converter={x:Static vm:StringJoinConverter.Instance}}" Width="*" MinWidth="160" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </TabItem>

                    <TabItem Header="Liens inter-sites">
                        <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="0">
                            <DataGrid ItemsSource="{Binding SiteLinks}"
                                      CanUserResizeColumns="True" CanUserSortColumns="True"
                                      CanUserReorderColumns="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn     Header="Nom"           Binding="{Binding Name}" Width="220" MinWidth="120" SortMemberPath="Name" />
                                    <DataGridTextColumn     Header="Sites reliés"  Binding="{Binding Sites, Converter={x:Static vm:StringJoinConverter.Instance}}" Width="280" MinWidth="160" />
                                    <DataGridTextColumn     Header="Coût"          Binding="{Binding Cost}"  Width="80"  MinWidth="60" SortMemberPath="Cost" />
                                    <DataGridTextColumn     Header="Intervalle"    Binding="{Binding ReplicationInterval, Converter={x:Static vm:LatencyToTextConverter.Instance}}" Width="110" MinWidth="80" SortMemberPath="ReplicationInterval" />
                                    <DataGridTextColumn     Header="Transport"     Binding="{Binding TransportType}" Width="130" MinWidth="90" SortMemberPath="TransportType" />
                                    <DataGridCheckBoxColumn Header="Notifications" Binding="{Binding ChangeNotificationEnabled}" Width="*" MinWidth="120" SortMemberPath="ChangeNotificationEnabled" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </TabItem>

                    <TabItem Header="Diagnostics">
                        <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" MinHeight="120" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition x:Name="IssueDetailRow">
                                        <RowDefinition.Style>
                                            <Style TargetType="RowDefinition">
                                                <Setter Property="Height" Value="Auto" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasSelectedIssue}" Value="True">
                                                        <Setter Property="Height" Value="1.5*" />
                                                        <Setter Property="MaxHeight" Value="320" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </RowDefinition.Style>
                                    </RowDefinition>
                                </Grid.RowDefinitions>

                                <!-- v0.8.0 : lignes = IssueRowViewModel (anomalie + conséquences repliées
                                     d'un DC injoignable). La liste plate Issues reste la source des exports. -->
                                <DataGrid Grid.Row="0" x:Name="IssuesGrid" ItemsSource="{Binding IssueRows}"
                                          SelectedItem="{Binding SelectedIssueRow, Mode=TwoWay}"
                                          SelectionMode="Single" IsReadOnly="True"
                                          CanUserResizeColumns="True" CanUserSortColumns="True"
                                          CanUserReorderColumns="True"
                                          RowDetailsVisibilityMode="Collapsed"
                                          EnableRowVirtualization="False"
                                          ScrollViewer.CanContentScroll="False">
                                    <!-- DetailsVisibility est posé directement sur la ligne par le code-behind du
                                         bouton (OnDerivedToggleChanged) : le DataGrid transfère son RowDetailsVisibilityMode
                                         aux lignes et écrase toute valeur venue d'un style. Pas de virtualisation ici
                                         (liste courte) pour qu'une ligne recyclée n'hérite pas de l'état d'une autre.
                                         CanContentScroll=False : défilement au pixel, sinon une ligne dépliée plus haute
                                         que la zone visible ne peut pas défiler (le DataGrid défile par ligne entière). -->
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="" Width="36" CanUserResize="False" CanUserSort="False">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Ellipse Width="10" Height="10"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                                             Fill="{Binding Issue.Severity, Converter={x:Static vm:IssueSeverityToBrushConverter.Instance}}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Sévérité" Binding="{Binding Issue.Severity}" Width="90"  MinWidth="70"  SortMemberPath="Issue.Severity" />
                                        <DataGridTextColumn Header="Code"     Binding="{Binding Issue.Code}"     Width="220" MinWidth="140" SortMemberPath="Issue.Code" />
                                        <DataGridTextColumn Header="Anomalie" Binding="{Binding Issue.Title}" Width="320" MinWidth="180" SortMemberPath="Issue.Title" />
                                        <!-- Colonne dédiée (la hauteur de ligne est fixe, pas de seconde ligne possible) :
                                             bouton texte « ▸ 10 anomalies liées à … » qui déplie les conséquences sous la ligne. -->
                                        <DataGridTemplateColumn Header="Conséquences" Width="300" MinWidth="200" CanUserSort="False">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                                  Checked="OnDerivedToggleChanged" Unchecked="OnDerivedToggleChanged"
                                                                  Visibility="{Binding HasChildren, Converter={x:Static vm:BoolToVisibleConverter.Instance}}"
                                                                  HorizontalAlignment="Left" VerticalAlignment="Center" Cursor="Hand" Focusable="False"
                                                                  Background="Transparent" BorderThickness="0" Padding="0"
                                                                  ToolTip="Afficher ou masquer les anomalies qui découlent de l'indisponibilité de ce DC">
                                                        <ToggleButton.Template>
                                                            <ControlTemplate TargetType="ToggleButton">
                                                                <TextBlock Foreground="{DynamicResource Accent}" TextTrimming="CharacterEllipsis">
                                                                    <Run x:Name="Arrow" Text="▸ " /><Run Text="{Binding DerivedSummary, Mode=OneWay}" />
                                                                </TextBlock>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsChecked" Value="True">
                                                                        <Setter TargetName="Arrow" Property="Text" Value="▾ " />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </ToggleButton.Template>
                                                    </ToggleButton>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Éléments concernés" Binding="{Binding Issue.AffectedItems, Converter={x:Static vm:StringJoinConverter.Instance}}" Width="220" MinWidth="140" />
                                        <DataGridTextColumn Header="Constat"            Binding="{Binding Issue.Description}" Width="*" MinWidth="260" />
                                    </DataGrid.Columns>
                                    <!-- Conséquences du DC injoignable : grille sans en-tête, en retrait ; la sélection
                                         d'un enfant alimente SelectedIssue (panneau de détail + Copier le diagnostic). -->
                                    <DataGrid.RowDetailsTemplate>
                                        <DataTemplate>
                                            <!-- Pas de DataGrid imbriqué : il aurait son propre scroll (la molette ne
                                                 remonterait pas à la grille principale) et sa propre sélection en concurrence
                                                 avec celle du parent. Une ligne = un bouton transparent qui sélectionne l'anomalie. -->
                                            <Border Background="{DynamicResource SurfaceAlt}" Padding="36,2,0,6"
                                                    BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                                                <ItemsControl ItemsSource="{Binding Children}" Focusable="False">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Command="{Binding DataContext.SelectIssueCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}" Cursor="Hand" Focusable="False"
                                                                    HorizontalContentAlignment="Stretch" Padding="0" Margin="0" BorderThickness="0">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="Bd" Background="Transparent" Padding="0,5">
                                                                            <ContentPresenter />
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowHover}" />
                                                                            </Trigger>
                                                                            <DataTrigger Value="True">
                                                                                <DataTrigger.Binding>
                                                                                    <MultiBinding Converter="{x:Static vm:SameReferenceConverter.Instance}">
                                                                                        <Binding />
                                                                                        <Binding Path="DataContext.SelectedIssue" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                                    </MultiBinding>
                                                                                </DataTrigger.Binding>
                                                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowSelected}" />
                                                                            </DataTrigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="36" />
                                                                        <ColumnDefinition Width="90" />
                                                                        <ColumnDefinition Width="220" />
                                                                        <ColumnDefinition Width="320" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Ellipse Grid.Column="0" Width="8" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                             Fill="{Binding Severity, Converter={x:Static vm:IssueSeverityToBrushConverter.Instance}}" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding Severity}" Margin="12,0" VerticalAlignment="Center" Foreground="{DynamicResource Foreground}" />
                                                                    <TextBlock Grid.Column="2" Text="{Binding Code}"     Margin="12,0" VerticalAlignment="Center" Foreground="{DynamicResource Foreground}" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Grid.Column="3" Text="{Binding Title}"    Margin="12,0" VerticalAlignment="Center" Foreground="{DynamicResource Foreground}" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Grid.Column="4" Text="{Binding AffectedItems, Converter={x:Static vm:StringJoinConverter.Instance}}"
                                                                               Margin="12,0" VerticalAlignment="Center" Foreground="{DynamicResource SubtleText}" TextTrimming="CharacterEllipsis" />
                                                                </Grid>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>
                                        </DataTemplate>
                                    </DataGrid.RowDetailsTemplate>
                                </DataGrid>

                                <TextBlock Grid.Row="0" Text="✓ Aucune anomalie de configuration détectée."
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Success}"
                                           FontSize="14" FontWeight="SemiBold"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding HasItems, ElementName=IssuesGrid}" Value="False" />
                                                        <Condition Binding="{Binding HasAuditData}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Row="0" Text="{Binding EmptyStateMessage}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource SubtleText}"
                                           FontSize="14" FontWeight="SemiBold"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding HasItems, ElementName=IssuesGrid}" Value="False" />
                                                        <Condition Binding="{Binding HasAuditData}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <Border Grid.Row="2" Padding="14,8" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding HasItems, ElementName=IssuesGrid}" Value="True" />
                                                        <Condition Binding="{Binding HasSelectedIssue}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="Sélectionnez une anomalie pour comprendre son impact et savoir quoi faire."
                                               Style="{StaticResource DetailLabel}" />
                                </Border>

                                <!-- Panneau de détail (v0.7.0) : constat / pourquoi / que faire. -->
                                <Thumb x:Name="IssueDetailSplitter" Grid.Row="1" Height="5" Cursor="SizeNS" Focusable="False"
                                       Visibility="{Binding HasSelectedIssue, Converter={x:Static vm:BoolToVisibleConverter.Instance}}">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{DynamicResource Border}" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                                <Border x:Name="IssueDetailPanel" Grid.Row="2" Padding="14,6,14,12"
                                        Visibility="{Binding DataContext.HasSelectedIssue, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static vm:BoolToVisibleConverter.Instance}}"
                                        DataContext="{Binding SelectedIssue}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Title, Mode=OneWay}"
                                                           FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource Foreground}" VerticalAlignment="Center" />
                                                <Button Grid.Column="1" Content="Copier le diagnostic" Margin="12,0,0,0" Padding="10,4"
                                                        Style="{StaticResource PrimaryButton}"
                                                        ToolTip="Copie la fiche complète (texte brut + HTML) pour un mail ou un ticket."
                                                        Command="{Binding DataContext.CopyIssueDiagnosticCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                <Button Grid.Column="2" Content="✕" Margin="6,0,0,0" Padding="8,4" ToolTip="Fermer le panneau"
                                                        Command="{Binding DataContext.CloseIssueDetailCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            </Grid>
                                            <TextBlock Style="{StaticResource DetailLabel}" Margin="0,2,0,0">
                                                <Run Text="{Binding Code, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding AffectedItems, Converter={x:Static vm:StringJoinConverter.Instance}, Mode=OneWay}" />
                                            </TextBlock>

                                            <TextBlock Text="Constat" Style="{StaticResource DetailHeading}" />
                                            <TextBlock Text="{Binding Description, Mode=OneWay}" Style="{StaticResource DetailBody}" />

                                            <TextBlock Text="Pourquoi c'est important" Style="{StaticResource DetailHeading}"
                                                       Visibility="{Binding Impact, Converter={x:Static vm:NullToCollapsedConverter.Instance}}" />
                                            <TextBlock Text="{Binding Impact, Mode=OneWay}" Style="{StaticResource DetailBody}"
                                                       Visibility="{Binding Impact, Converter={x:Static vm:NullToCollapsedConverter.Instance}}" />

                                            <TextBlock Text="Que faire" Style="{StaticResource DetailHeading}"
                                                       Visibility="{Binding Recommendation, Converter={x:Static vm:NullToCollapsedConverter.Instance}}" />
                                            <ItemsControl ItemsSource="{Binding Recommendation, Converter={x:Static vm:StepsSplitConverter.Instance}, Mode=OneWay}"
                                                          AlternationCount="100"
                                                          ItemTemplate="{StaticResource NumberedItemTemplate}" />

                                            <Button Style="{StaticResource DetailLinkButton}" Margin="0,10,0,0"
                                                    Content="Documentation Microsoft ↗"
                                                    Visibility="{Binding DocumentationUrl, Converter={x:Static vm:NullToCollapsedConverter.Instance}}"
                                                    Click="OnOpenUrlClick" Tag="{Binding DocumentationUrl, Mode=OneWay}" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Border>
                    </TabItem>

                    <TabItem Header="Santé DNS">
                        <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="0">
                            <Grid>
                                <DataGrid x:Name="DnsGrid" ItemsSource="{Binding DnsChecks}"
                                          CanUserResizeColumns="True" CanUserSortColumns="True"
                                          CanUserReorderColumns="True">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="" Width="36" CanUserResize="False" CanUserSort="False">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Ellipse Width="10" Height="10"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                                             Fill="{Binding Status, Converter={x:Static vm:DnsCheckStatusToBrushConverter.Instance}}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Type"           Binding="{Binding Type, Converter={x:Static vm:DnsCheckedRecordTypeToTextConverter.Instance}}"  Width="130" MinWidth="100" SortMemberPath="Type" />
                                        <DataGridTextColumn Header="Enregistrement" Binding="{Binding RecordName}"   Width="320" MinWidth="180" SortMemberPath="RecordName" />
                                        <DataGridTextColumn Header="Statut"         Binding="{Binding Status}"       Width="90"  MinWidth="70"  SortMemberPath="Status" />
                                        <DataGridTextColumn Header="Cible"          Binding="{Binding Target}"       Width="260" MinWidth="160" SortMemberPath="Target" />
                                        <DataGridTextColumn Header="Port"           Binding="{Binding Port}"         Width="70"  MinWidth="50"  SortMemberPath="Port" />
                                        <DataGridTextColumn Header="IP"             Binding="{Binding IpAddress}"    Width="130" MinWidth="100" SortMemberPath="IpAddress" />
                                        <DataGridTextColumn Header="Détail"          Binding="{Binding ErrorMessage}" Width="*"   MinWidth="200" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <TextBlock Text="✓ Aucun audit DNS exécuté — lancez Actualiser."
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource SubtleText}"
                                           FontSize="14" FontWeight="SemiBold"
                                           IsHitTestVisible="False"
                                           Visibility="{Binding HasItems, ElementName=DnsGrid,
                                                        Converter={x:Static vm:BoolToCollapsedConverter.Instance}}" />
                            </Grid>
                        </Border>
                    </TabItem>

                    <TabItem Header="Santé réseau">
                        <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="0">
                            <Grid>
                                <DataGrid x:Name="PortsGrid" ItemsSource="{Binding PortChecks}"
                                          CanUserResizeColumns="True" CanUserSortColumns="True"
                                          CanUserReorderColumns="True">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="" Width="36" CanUserResize="False" CanUserSort="False">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Ellipse Width="10" Height="10"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                                             Fill="{Binding Status, Converter={x:Static vm:PortCheckStatusToBrushConverter.Instance}}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Contrôleur"      Binding="{Binding HostName}"     Width="260" MinWidth="160" SortMemberPath="HostName" />
                                        <DataGridTextColumn Header="Port"            Binding="{Binding Port}"         Width="80"  MinWidth="60"  SortMemberPath="Port" />
                                        <DataGridTextColumn Header="Service"         Binding="{Binding ServiceLabel}" Width="180" MinWidth="120" SortMemberPath="ServiceLabel" />
                                        <DataGridTextColumn Header="Statut"          Binding="{Binding Status}"       Width="100" MinWidth="70"  SortMemberPath="Status" />
                                        <DataGridTextColumn Header="Temps de réponse" Binding="{Binding ResponseTime, Converter={x:Static vm:LatencyToTextConverter.Instance}}" Width="130" MinWidth="100" SortMemberPath="ResponseTime" />
                                        <DataGridTextColumn Header="Détail"          Binding="{Binding ErrorMessage}" Width="*"   MinWidth="200" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <TextBlock Text="✓ Aucun test de port exécuté — lancez Actualiser."
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource SubtleText}"
                                           FontSize="14" FontWeight="SemiBold"
                                           IsHitTestVisible="False"
                                           Visibility="{Binding HasItems, ElementName=PortsGrid,
                                                        Converter={x:Static vm:BoolToCollapsedConverter.Instance}}" />
                            </Grid>
                        </Border>
                    </TabItem>

                    <!-- ====================================================================
                         9ème onglet : Comparaison de deux audits (v0.5.0)
                         Masqué tant qu'aucun diff n'est calculé.
                         ==================================================================== -->
                    <TabItem Header="Comparaison"
                             Visibility="{Binding Compare.HasDiff, Converter={x:Static vm:BoolToVisibleConverter.Instance}}">
                        <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="20">

                                    <!-- Bandeau récap -->
                                    <Border Background="{DynamicResource SurfaceAlt}"
                                            BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                            CornerRadius="4" Padding="14">
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" FontSize="13"
                                                       Foreground="{DynamicResource Foreground}">
                                                <Run Text="Forêt : " />
                                                <Run Text="{Binding Compare.Diff.CurrentForestName, Mode=OneWay}" />
                                            </TextBlock>
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <TextBlock Foreground="{DynamicResource SubtleText}">
                                                    <Run Text="Référence : " />
                                                    <Run Text="{Binding Compare.Diff.ReferenceGeneratedAt, StringFormat='{}{0:dd/MM/yyyy HH:mm}', Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Foreground="{DynamicResource SubtleText}" Margin="24,0,0,0">
                                                    <Run Text="Courant : " />
                                                    <Run Text="{Binding Compare.Diff.CurrentGeneratedAt, StringFormat='{}{0:dd/MM/yyyy HH:mm}', Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource Warning}"
                                                       Visibility="{Binding Compare.Diff.DifferentForests, Converter={x:Static vm:BoolToVisibleConverter.Instance}}">
                                                <Run Text="⚠ Forêts différentes : " />
                                                <Run Text="{Binding Compare.Diff.ReferenceForestName, Mode=OneWay}" />
                                                <Run Text=" vs " />
                                                <Run Text="{Binding Compare.Diff.CurrentForestName, Mode=OneWay}" />
                                                <Run Text=" — la comparaison reste affichée mais a peu de sens fonctionnellement." />
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>

                                    <!-- Évolution du score (cachée si Score null) -->
                                    <Border Background="{DynamicResource SurfaceAlt}"
                                            BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                            CornerRadius="4" Padding="14" Margin="0,12,0,0"
                                            Visibility="{Binding Compare.Diff.Score, Converter={x:Static vm:NullToCollapsedConverter.Instance}}">
                                        <StackPanel>
                                            <TextBlock Text="Évolution du score" FontWeight="SemiBold" FontSize="13"
                                                       Foreground="{DynamicResource Foreground}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <TextBlock Foreground="{DynamicResource SubtleText}">
                                                    <Run Text="Score : " />
                                                    <Run Text="{Binding Compare.Diff.Score.ValueBefore, Mode=OneWay}" />
                                                    <Run Text="/100 → " />
                                                    <Run Text="{Binding Compare.Diff.Score.ValueAfter, Mode=OneWay}" />
                                                    <Run Text="/100 (delta " />
                                                    <Run Text="{Binding Compare.Diff.Score.Delta, Mode=OneWay}" />
                                                    <Run Text=")" />
                                                </TextBlock>
                                                <TextBlock Margin="24,0,0,0" Foreground="{DynamicResource SubtleText}">
                                                    <Run Text="Niveau : " />
                                                    <Run Text="{Binding Compare.Diff.Score.LevelBefore, Mode=OneWay}" />
                                                    <Run Text=" → " />
                                                    <Run Text="{Binding Compare.Diff.Score.LevelAfter, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Changements significatifs -->
                                    <TextBlock Text="Changements significatifs" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Foreground}"
                                               Margin="0,18,0,6" />
                                    <Border Style="{StaticResource Card}" Padding="0">
                                        <Grid>
                                            <DataGrid x:Name="SignificantChangesGrid"
                                                      ItemsSource="{Binding Compare.SignificantChanges}"
                                                      CanUserResizeColumns="True"
                                                      CanUserSortColumns="True"
                                                      MinHeight="120" MaxHeight="280">
                                                <DataGrid.Columns>
                                                    <DataGridTemplateColumn Header="" Width="36" CanUserResize="False" CanUserSort="False">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Ellipse Width="10" Height="10"
                                                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                         Fill="{Binding Severity, Converter={x:Static vm:IssueSeverityToBrushConverter.Instance}}" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTextColumn Header="Sévérité"    Binding="{Binding Severity}"   Width="90"  MinWidth="70" SortMemberPath="Severity" />
                                                    <DataGridTextColumn Header="Code"        Binding="{Binding Code}"       Width="220" MinWidth="150" SortMemberPath="Code" />
                                                    <DataGridTextColumn Header="Description" Binding="{Binding Title}"      Width="*"   MinWidth="240" />
                                                </DataGrid.Columns>
                                            </DataGrid>

                                            <TextBlock Text="✓ Aucun changement significatif détecté entre les deux audits."
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Success}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       IsHitTestVisible="False"
                                                       Visibility="{Binding HasItems, ElementName=SignificantChangesGrid, Converter={x:Static vm:BoolToCollapsedConverter.Instance}}" />
                                        </Grid>
                                    </Border>

                                    <!-- Récap par catégorie -->
                                    <TextBlock Text="Différences détaillées" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Foreground}"
                                               Margin="0,18,0,6" />
                                    <Border Style="{StaticResource Card}" Padding="14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="90" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- En-têtes -->
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Catégorie"     FontWeight="SemiBold" Foreground="{DynamicResource SubtleText}" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Ajouts"        FontWeight="SemiBold" Foreground="{DynamicResource SubtleText}" HorizontalAlignment="Right" />
                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Suppressions"  FontWeight="SemiBold" Foreground="{DynamicResource SubtleText}" HorizontalAlignment="Right" />
                                            <TextBlock Grid.Row="0" Grid.Column="3" Text="Modifs"        FontWeight="SemiBold" Foreground="{DynamicResource SubtleText}" HorizontalAlignment="Right" />

                                            <!-- DCs -->
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Contrôleurs"             Margin="0,4,0,0" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Compare.Diff.DomainControllers.Added.Count}"   Margin="0,4,0,0" HorizontalAlignment="Right" />
                                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Compare.Diff.DomainControllers.Removed.Count}" Margin="0,4,0,0" HorizontalAlignment="Right" />
                                            <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Compare.Diff.DomainControllers.Changed.Count}" Margin="0,4,0,0" HorizontalAlignment="Right" />

                                            <!-- Liens -->
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Liens de réplication"    Margin="0,4,0,0" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Compare.Diff.ReplicationLinks.Added.Count}"    Margin="0,4,0,0" HorizontalAlignment="Right" />
                                            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Compare.Diff.ReplicationLinks.Removed.Count}"  Margin="0,4,0,0" HorizontalAlignment="Right" />
                                            <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding Compare.Diff.ReplicationLinks.Changed.Count}"  Margin="0,4,0,0" HorizontalAlignment="Right" />

                                            <!-- Failures -->
                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Échecs de réplication"   Margin="0,4,0,0" />
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Compare.Diff.ReplicationFailures.Added.Count}"   Margin="0,4,0,0" HorizontalAlignment="Right" />
                                            <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding Compare.Diff.ReplicationFailures.Removed.Count}" Margin="0,4,0,0" HorizontalAlignment="Right" />
                                            <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding Compare.Diff.ReplicationFailures.Changed.Count}" Margin="0,4,0,0" HorizontalAlignment="Right" />

                                            <!-- Sites -->
                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Sites"                   Margin="0,4,0,0" />
                                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Compare.Diff.Sites.Added.Count}"   Margin="0,4,0,0" HorizontalAlignment="Right" />
                                            <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding Compare.Diff.Sites.Removed.Count}" Margin="0,4,0,0" HorizontalAlignment="Right" />
                                            <TextBlock Grid.Row="4" Grid.Column="3" Text="{Binding Compare.Diff.Sites.Changed.Count}" Margin="0,4,0,0" HorizontalAlignment="Right" />

                                            <!-- Site links -->
                                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Liens inter-sites"       Margin="0,4,0,0" />
                                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Compare.Diff.SiteLinks.Added.Count}"   Margin="0,4,0,0" HorizontalAlignment="Right" />
                                            <TextBlock Grid.Row="5" Grid.Column="2" Text="{Binding Compare.Diff.SiteLinks.Removed.Count}" Margin="0,4,0,0" HorizontalAlignment="Right" />
                                            <TextBlock Grid.Row="5" Grid.Column="3" Text="{Binding Compare.Diff.SiteLinks.Changed.Count}" Margin="0,4,0,0" HorizontalAlignment="Right" />

                                            <!-- Issues -->
                                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Anomalies"               Margin="0,4,0,0" />
                                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Compare.Diff.Issues.Added.Count}"   Margin="0,4,0,0" HorizontalAlignment="Right" />
                                            <TextBlock Grid.Row="6" Grid.Column="2" Text="{Binding Compare.Diff.Issues.Removed.Count}" Margin="0,4,0,0" HorizontalAlignment="Right" />
                                            <TextBlock Grid.Row="6" Grid.Column="3" Text="-"                                            Margin="0,4,0,0" HorizontalAlignment="Right" />

                                            <!-- DNS -->
                                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Vérifications DNS"      Margin="0,4,0,0" />
                                            <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Compare.Diff.DnsChecks.Added.Count}"   Margin="0,4,0,0" HorizontalAlignment="Right" />
                                            <TextBlock Grid.Row="7" Grid.Column="2" Text="{Binding Compare.Diff.DnsChecks.Removed.Count}" Margin="0,4,0,0" HorizontalAlignment="Right" />
                                            <TextBlock Grid.Row="7" Grid.Column="3" Text="{Binding Compare.Diff.DnsChecks.Changed.Count}" Margin="0,4,0,0" HorizontalAlignment="Right" />

                                            <!-- Ports -->
                                            <TextBlock Grid.Row="8" Grid.Column="0" Text="Tests de ports"          Margin="0,4,0,0" />
                                            <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding Compare.Diff.PortChecks.Added.Count}"   Margin="0,4,0,0" HorizontalAlignment="Right" />
                                            <TextBlock Grid.Row="8" Grid.Column="2" Text="{Binding Compare.Diff.PortChecks.Removed.Count}" Margin="0,4,0,0" HorizontalAlignment="Right" />
                                            <TextBlock Grid.Row="8" Grid.Column="3" Text="{Binding Compare.Diff.PortChecks.Changed.Count}" Margin="0,4,0,0" HorizontalAlignment="Right" />
                                        </Grid>
                                    </Border>

                                    <!-- Bouton effacer -->
                                    <Button Content="Effacer la comparaison"
                                            Command="{Binding Compare.ClearCommand}"
                                            HorizontalAlignment="Right" Margin="0,16,0,0" />

                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </TabItem>

                </TabControl>
            </Border>

        </DockPanel>

        <!-- ====================================================================
             Toast overlay (v0.5.0)
             Positionné en bas-droite, animé par code-behind via OnShowAlert.
             ==================================================================== -->
        <Border x:Name="ToastBorder"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,28,64"
                Background="{DynamicResource ToastBackground}"
                CornerRadius="6" Padding="16,12"
                MaxWidth="380"
                Opacity="0"
                Visibility="Collapsed"
                Cursor="Hand"
                MouseLeftButtonUp="OnToastClick">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.4" BlurRadius="16" ShadowDepth="3" />
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="Alerte de surveillance"
                           Foreground="{DynamicResource ToastForeground}"
                           FontWeight="SemiBold" FontSize="13" />
                <TextBlock x:Name="ToastText" Text=""
                           Foreground="{DynamicResource ToastForeground}"
                           FontSize="12" Margin="0,4,0,0"
                           TextWrapping="Wrap" />
                <TextBlock Text="Cliquer pour acquitter."
                           Foreground="{DynamicResource ToastForeground}"
                           FontStyle="Italic" Opacity="0.7"
                           FontSize="11" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

    </Grid>
</Window>
